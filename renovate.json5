{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // The Rakiura-Inc preset: https://github.com/Rakiura-Inc/.github/blob/main/renovate-config.json5
    "github>Rakiura-Inc/.github:renovate-config.json5",
  ],
  // The generated projects' files are Jinja templates, which Renovate's own managers do not read.
  // template/.pre-commit-config.yaml is plain YAML and is updated by the pre-commit manager.
  "customManagers": [
    {
      // Exact pins like "ruff==0.17.3" in the generated pyproject.toml.
      "customType": "regex",
      "managerFilePatterns": ["/^template/pyproject\\.toml\\.jinja$/"],
      "matchStrings": ["\"(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi",
    },
    {
      // `uses: owner/repo/...@<sha>  # vX.Y.Z` in the generated workflows.
      "customType": "regex",
      "managerFilePatterns": ["/^template/\\.github/workflows/.+\\.ya?ml\\.jinja$/"],
      "matchStrings": [
        "uses: (?<depName>[^@\\s/]+/[^@\\s/]+)[^@\\s]*@(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>v\\S+)",
      ],
      "datasourceTemplate": "github-tags",
    },
  ],
}
